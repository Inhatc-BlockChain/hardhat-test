# 설치된 패키지 (약 200MB) → 받은 사람이 npm ci 로 다시 설치
node_modules/

# build 결과 (npx hardhat build 로 다시 만들어짐)
artifacts/
cache/
types/

# 배포 기록 (PC, 학생마다 다름: 로컬 chain-31337, Sepolia chain-11155111)
ignition/deployments/

# 비밀값 (개인 키 등은 keystore 에 저장하지만, 실수로 만든 파일도 올라가지 않게)
.env
.env.*
*.key

# 테스트 커버리지, 로그, OS 파일
coverage/
coverage.json
*.log
.DS_Store
Thumbs.db
